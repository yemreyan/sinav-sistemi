# Sunucu portu
PORT=3001

# Yönetici paneli şifresi — zorunlu. Tanımlı değilse /api/admin/login 500 döner.
ADMIN_PASSWORD=

# Admin oturum token'larının imzalandığı gizli anahtar — zorunlu.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Tanımlı değilse her açılışta geçici bir anahtar üretilir ve sunucu yeniden
# başladığında tüm admin oturumları düşer.
ADMIN_TOKEN_SECRET=
